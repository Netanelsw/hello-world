{
  "expo": {
    "name": "Willon",
    "slug": "willon",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFF0F5"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.willon.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF0F5"
      },
      "package": "com.willon.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
